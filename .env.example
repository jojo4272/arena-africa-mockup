# Database
# Required: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/arena_africa

# Authentication
# Required in production: Secret key for HMAC token signing (min 32 chars)
# SECURITY: Generate a secure random string in production
# Example: openssl rand -base64 32
AUTH_SECRET=your-secure-secret-key-min-32-characters-change-this-in-production!!!

# AI Features (Optional)
# Optional: Google Gemini API key for AI-powered features
# When absent, AI features degrade to deterministic heuristics
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# Application
NODE_ENV=development
