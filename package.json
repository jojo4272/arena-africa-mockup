{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx socket.io.server.js\"",
    "dev:next": "next dev",
    "dev:socket": "tsx socket.io.server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push --config=drizzle.config.json && psql $env:DATABASE_URL -f src/db/indexes.sql",
    "start:socket": "tsx socket.io.server.js"
  },
  "dependencies": {
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-query": "^5.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-window": "^1.8.10",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "^5.0.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "tsx": "^4.19.2",
    "@types/react-window": "^1.8.8"
  }
}
